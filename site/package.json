{
  "name": "vkui-skill-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint --deny-warnings src scripts tests playwright.config.mjs vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build -- --logLevel error"
  },
  "dependencies": {
    "@vkontakte/icons": "3.74.0",
    "@vkontakte/vkui": "8.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "oxlint": "1.86.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
